# Settings for `docker compose` (copy to .env). All optional except APP_PASSWORD
# if the app can be reached by anyone but you.

# Password for the whole app. Strongly recommended anywhere beyond localhost.
APP_PASSWORD=

# Address and port the app listens on, on the host.
# 127.0.0.1 = this machine only. Use your VPN address, or 0.0.0.0 behind a proxy.
BIND=127.0.0.1
PORT=8000

# Who owns the files in ./data (run `id -u` and `id -g`).
UID=1000
GID=1000

# Rootless Podman only: makes the container user map to your own user.
# USERNS_MODE=keep-id

# Use another image instead of building it (a registry you publish to yourself).
# INSAR_IMAGE=
